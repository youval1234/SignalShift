    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Theme_10131B}"/><Setter Property="Foreground" Value="{DynamicResource Theme_F0F0F6}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme_34394B}"/><Setter Property="CaretBrush" Value="{DynamicResource Theme_BAA8FF}"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="14"/><Setter Property="SelectionBrush" Value="{DynamicResource Theme_70609F}"/></Style>

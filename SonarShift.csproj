<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>SonarShift.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(SonarShiftStore)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants Condition="'$(SonarShiftStore)' == 'true'">$(DefineConstants);SONARSHIFT_STORE</DefineConstants>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\SonarShift.ico</ApplicationIcon>
    <AssemblyName>SonarShift</AssemblyName>
    <Version>1.5.0</Version>
    <Product>SonarShift</Product>
    <Description>A quieter way to switch your sound.</Description>
    <Company>SonarShift</Company>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\SonarShift.ico" /><Resource Include="Assets\SonarShift.png" /><Resource Include="Assets\SwitchOutput.wav" /><Resource Include="Assets\SwitchInput.wav" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\SonarShift.ico" LogicalName="SonarShift.TrayIcon" />
    <EmbeddedResource Include="Assets\SwitchOutput.wav" LogicalName="SonarShift.OutputSound" />
    <EmbeddedResource Include="Assets\SwitchInput.wav" LogicalName="SonarShift.InputSound" />
  </ItemGroup>
</Project>

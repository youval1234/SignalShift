<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>SonarShift.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DefineConstants Condition="'$(SonarShiftStore)' == 'true'">$(DefineConstants);SONARSHIFT_STORE</DefineConstants>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\SonarShift.ico</ApplicationIcon>
    <AssemblyName>SignalShift</AssemblyName>
    <Version>2.4.3</Version>
    <InformationalVersion>2.4.3</InformationalVersion>
    <Product>SignalShift</Product>
    <Description>Audio profiles and appearance, one shortcut away.</Description>
    <Company>SignalShift</Company>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Compressed assemblies are expanded into private memory in each process.
         Prefer file-backed assemblies so the host and settings can share pages. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio.Wasapi" Version="2.2.1" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\SonarShift.ico" /><Resource Include="Assets\SonarShift.png" /><Resource Include="Assets\SwitchOutput.wav" /><Resource Include="Assets\SwitchInput.wav" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="SignalShift.ThirdPartyNotices" />
    <Compile Remove="Packaging\StartupProjection\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="Assets\SonarShift.ico" LogicalName="SonarShift.TrayIcon" />
    <EmbeddedResource Include="Assets\SwitchOutput.wav" LogicalName="SonarShift.OutputSound" />
    <EmbeddedResource Include="Assets\SwitchInput.wav" LogicalName="SonarShift.InputSound" />
  </ItemGroup>
  <ItemGroup Condition="'$(SonarShiftStore)' == 'true'">
    <ProjectReference Include="Packaging\StartupProjection\StartupProjection.csproj" />
    <Content Include="Packaging\StartupProjection\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
